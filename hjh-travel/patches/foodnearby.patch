+  public async getRoute(origin: Coordinates, destination: Coordinates, mode: 'walking' | 'driving') {
+    if (!this.amapApiKey) {
+      throw new Error('未配置高德地图API密钥');
+    }
+    const url = `https://restapi.amap.com/v3/direction/${mode}`;
+    const params = {
+      key: this.amapApiKey,
+      origin: `${origin.lng},${origin.lat}`,
+      destination: `${destination.lng},${destination.lat}`,
+    };
+    const { data } = await axios.get<{
+      status: string;
+      info?: string;
+      route?: { paths?: Array<{ distance: string; duration: string }> };
+    }>(url, { params, timeout: 10000 });
+    if (data.status !== '1') {
+      throw new Error(`高德地图路线查询失败: ${data.info ?? '未知错误'}`);
+    }
+    const firstPath = data.route?.paths?.[0];
+    const distance = Number(firstPath?.distance);
+    const duration = Number(firstPath?.duration);
+    if (!Number.isFinite(distance) || !Number.isFinite(duration) || distance < 0 || duration < 0) {
+      throw new Error('高德地图未返回可用路线');
+    }
+    return { distance_m: distance, duration_s: duration };
+  }
