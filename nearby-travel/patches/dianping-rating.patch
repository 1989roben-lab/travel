+test("reads the displayed shop score without inferring it from sub-scores", () => {
+  const url = "https://www.dianping.com/shop/G2";
+  const html = `
+    <title>【示例餐厅】电话_地址_价格 - 大众点评网</title>
+    <div class="star-container"><div class="star-score score-35">3.9</div></div>
+    <div class="brief-info"><span class="item">口味:4.1</span></div>`;
+  const result = parsePlaceDetails(html, url, 0);
+  assert.equal(result.name, "示例餐厅");
